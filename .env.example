# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Tavily — retrieval (search + extract). Create a key at https://app.tavily.com
TAVILY_API_KEY="tvly-..."

# OpenAI — synthesis + entity resolution via the Responses API (structured outputs).
# Create a key at https://platform.openai.com. The model is set in
# backend/src/vendor_dd/engine/llm.py (_DEFAULT_MODEL) and is swappable per-call.
OPENAI_API_KEY="sk-..."

# Optional — where the structured JSON logs are written (default: ./logs).
# VENDOR_DD_LOG_DIR="logs"
# VENDOR_DD_LOG_LEVEL="INFO"
